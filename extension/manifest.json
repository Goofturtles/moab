{
  "manifest_version": 3,
  "name": "Overture in-call panel",
  "short_name": "Overture",
  "version": "1.1.1",
  "description": "Opens Overture's in-call panel (Overture on this PC, http://localhost:3576) in Chrome's side panel on Google Meet and Zoom web calls, and reads Google Meet's captions (when CC is on) so Overture can find who and what was mentioned.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "http://localhost:3576/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "captions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Overture's in-call panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self'; frame-src http://localhost:3576; connect-src http://localhost:3576; base-uri 'none'; form-action 'none'"
  }
}
